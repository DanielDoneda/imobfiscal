# Frontend — variáveis de ambiente
# Copiar para .env e preencher os valores

# URL da API em produção (Render.com ou Railway)
# Em desenvolvimento NÃO é necessário — o Vite faz proxy automaticamente
# Exemplo: VITE_API_URL=https://imobfiscal-backend.onrender.com/api
VITE_API_URL=

# URL do serviço Python de relatórios.
# Em desenvolvimento, o padrão é http://localhost:8090.
# Exemplo em produção: VITE_REPORTS_API_URL=https://imobfiscal-relatorios.onrender.com
VITE_REPORTS_API_URL=
